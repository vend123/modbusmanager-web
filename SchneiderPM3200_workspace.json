  "script": "(* Schneider PM3200: Power Factor (3078-3084) is \"4Q FP PF\", -2..+2.   *)\n(* Above 1 or below -1 the power factor is leading: 2 - x or -2 - x.      *)\n(* (PM3200 series user manual DOCA0006EN-09, power factor register format) *)\nIF PF_total_4q > 1 THEN PF_total := 2 - PF_total_4q;\nELSIF PF_total_4q < -1 THEN PF_total := -2 - PF_total_4q;\nELSE PF_total := PF_total_4q; END_IF;\nIF PF1_4q > 1 THEN PF1 := 2 - PF1_4q; ELSIF PF1_4q < -1 THEN PF1 := -2 - PF1_4q; ELSE PF1 := PF1_4q; END_IF;\nIF PF2_4q > 1 THEN PF2 := 2 - PF2_4q; ELSIF PF2_4q < -1 THEN PF2 := -2 - PF2_4q; ELSE PF2 := PF2_4q; END_IF;\nIF PF3_4q > 1 THEN PF3 := 2 - PF3_4q; ELSIF PF3_4q < -1 THEN PF3 := -2 - PF3_4q; ELSE PF3 := PF3_4q; END_IF;\n(* Energy: Int64 Wh in four registers, highest word first (3204-3207).    *)\n(* ModbusManager has no Int64 type, so the words are combined here.       *)\nE_imp_kWh := (((E_imp_w0 * 65536.0 + E_imp_w1) * 65536.0 + E_imp_w2) * 65536.0 + E_imp_w3) / 1000.0;\nE_imp_f32_kWh := E_imp_f32_Wh / 1000.0;\nE_exp_kWh := E_exp_f32_Wh / 1000.0;\n",
