  "script": "(* GenComm page 3 flags: bit n/16 is bit n-1 from the right *)\nShutdown := ((Flags - (Flags MOD 4096)) / 4096) MOD 2;\nTrip := ((Flags - (Flags MOD 2048)) / 2048) MOD 2;\nWarning := ((Flags - (Flags MOD 1024)) / 1024) MOD 2;\nIF Shutdown = 1 OR Trip = 1 THEN Gen_Fault := 1; ELSE Gen_Fault := 0; END_IF;\nIF Engine_rpm > 300 THEN Gen_Run := 1; ELSE Gen_Run := 0; END_IF;\nIF Mains_V1 > 180 THEN Mains_OK := 1; ELSE Mains_OK := 0; END_IF;\nIF Gen_V1 > 180 THEN Gen_Avail := 1; ELSE Gen_Avail := 0; END_IF;\nIF Gen_kW > 1 THEN On_Gen := 1; ELSE On_Gen := 0; END_IF;\nIF On_Gen = 0 AND Mains_OK = 1 THEN On_Mains := 1; ELSE On_Mains := 0; END_IF;\nIF Control_Mode = 1 THEN Auto := 1; ELSE Auto := 0; END_IF;\nRun_h := Run_s / 3600;\n",
