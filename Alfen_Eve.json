  "script": "(* Mode 3 state is a string; its first register holds two ASCII characters:\n   \"A\" 0x4100, \"B1\" 0x4231, \"C2\" 0x4332, \"D2\" 0x4432, \"E\" 0x4500, \"F\" 0x4600 *)\nIF Mode3 >= 16896 AND Mode3 < 17664 THEN Connected := 1; ELSE Connected := 0; END_IF;\nIF Mode3 = 17202 OR Mode3 = 17458 THEN Charging := 1; ELSE Charging := 0; END_IF;\nIF Mode3 >= 17664 OR Meter_State >= 8 THEN Fault := 1; ELSE Fault := 0; END_IF;\n",
